{
  "name": "sis",
  "version": "0.0.1.10",
  "description": "SIS service workspace",
  "private": true,
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": "20.19.4"
  },
  "scripts": {
    "html:normalize-self-closing": "node tools/normalize-html-self-closing.mjs",
    "build:admin-assets": "node tools/build-admin-assets.mjs",
    "build:admin-assets:check": "node tools/build-admin-assets.mjs --check",
    "start": "NODE_ENV=production SIS_ENV_FILE=.env node server/exercise-mailer.mjs",
    "dev": "NODE_ENV=development SIS_ENV_FILE=.env.dev node server/exercise-mailer.mjs",
    "dev:restart": "tools/restart-dev-runtime.sh",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:backup": "node tools/db-backup-failsafe.mjs",
    "db:backup:dry": "node tools/db-backup-failsafe.mjs --dry-run",
    "db:backup:no-prune": "node tools/db-backup-failsafe.mjs --no-prune",
    "backup:files": "node tools/backup-before-edit.mjs",
    "db:restore": "node tools/db-restore-failsafe.mjs",
    "db:restore:verify": "node tools/db-restore-failsafe.mjs --verify-only",
    "db:test:restore:verify": "tools/restore-test-db-from-live-dump.sh --verify-only",
    "db:test:restore": "tools/restore-test-db-from-live-dump.sh --yes",
    "db:rollover": "node tools/school-year-rollover.mjs archive",
    "db:rollover:inspect": "node tools/school-year-rollover.mjs inspect",
    "db:rollover:help": "node tools/school-year-rollover.mjs --help",
    "db:school-year:migrate-label": "node tools/migrate-school-year-label.mjs",
    "db:auto-import:cleanup-titles": "node tools/cleanup-auto-import-exercise-titles.mjs",
    "db:incoming:vacuum": "node tools/vacuum-incoming-exercise-results.mjs",
    "news:validation:audit": "node tools/news-validation-audit.mjs",
    "db:health:check": "node tools/db-health-check.mjs",
    "ops:incoming:vacuum:cron:check": "tools/install-incoming-vacuum-cron.sh --check-only",
    "ops:maintenance:systemd:check": "tools/install-maintenance-systemd.sh --check-only",
    "ffs-sis-public-root": "ffs-sis-public-root --batch",
    "ffs-sis-root": "ffs-sis-root --batch",
    "sync:full:sis-public-root": "ffs-sis-public-root --batch",
    "sync:full:sis-root": "ffs-sis-root --batch",
    "sync:portal:check": "tools/sync-portal-bidirectional.sh --check-only",
    "sync:portal:dev-to-live": "tools/sync-portal-bidirectional.sh --apply --dev-to-live",
    "sync:portal:live-to-dev": "tools/sync-portal-bidirectional.sh --apply --live-to-dev",
    "sync:live:admin:check": "tools/sync-and-restart-live-runtime.sh check-only",
    "sync:live:admin:backup": "tools/sync-and-restart-live-runtime.sh backup-only",
    "sync:live:admin:full": "tools/sync-and-restart-live-runtime.sh full",
    "sync:full:admin-root:restart-runtimes": "tools/sync-and-restart-live-runtime.sh full",
    "deploy:moodle-plugin": "bash tools/deploy-moodle-plugin.sh",
    "ops:moodle:php:check": "bash tools/check-moodle-php-host.sh",
    "sync:proof:portal": "tools/verify-portal-sync-proof.sh",
    "sync:full:sis-root:restart-runtimes": "tools/sync-and-restart-runtimes.sh full",
    "sync:full:sis-public-root:restart-runtimes": "tools/sync-and-restart-runtimes.sh public",
    "runtimes:restart": "tools/sync-and-restart-runtimes.sh restart-only",
    "worker:async-side-effects": "node tools/async-side-effects-worker.mjs",
    "test:runtime:sync-restart": "tools/sync-and-restart-test-runtime.sh full",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:lighthouse:admin": "node tools/lighthouse-admin-audit.mjs",
    "lint": "npm run lint:html && npm run lint:js && npm run lint:css",
    "lint:html": "html-validate web-asset/admin/student-admin.html web-asset/admin/portal-hub.html web-asset/parent/parent-portal.html web-asset/student/student-portal.html web-asset/student/fi.html",
    "lint:js": "eslint --config eslint.config.mjs server test tools --max-warnings=0",
    "lint:css": "stylelint --config stylelint.config.mjs web-asset/admin/student-admin.html",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node tools/test-suite.mjs all",
    "test:dev": "SIS_ENV_FILE=.env.dev node tools/test-suite.mjs core",
    "test:dev:playwright": "SIS_ENV_FILE=.env.dev node tools/test-suite.mjs playwright",
    "test:mirror:test": "SIS_ENV_FILE=.env.test node tools/test-suite.mjs all",
    "test:mirror:live": "SIS_ENV_FILE=.env node tools/test-suite.mjs all",
    "test:portal-chip-contract": "node --test test/portal-chip-contract.spec.mjs",
    "test:redis": "node tools/test-redis.mjs",
    "test:session-store": "node --test test/student-admin-session-store.spec.mjs",
    "test:watch": "node --test --watch test/*.spec.mjs",
    "smoke:admin-live": "node tools/admin-live-endpoint-smoke.mjs --mutations",
    "smoke:admin-live:full": "node tools/admin-live-endpoint-smoke.mjs --mutations --points --notifications",
    "smoke:admin-live:read": "node tools/admin-live-endpoint-smoke.mjs",
    "map:deps": "node tools/build-mapping-stack.mjs --deps-only",
    "map:openapi:lint": "redocly lint --config redocly.yaml docs/mapping/openapi/sis-admin.openapi.yaml",
    "map:openapi:build": "node tools/build-mapping-stack.mjs --openapi-only",
    "map:all": "node tools/build-mapping-stack.mjs"
  },
  "keywords": [
    "sis",
    "student",
    "admin",
    "english language education",
    "school",
    "student information system"
  ],
  "author": "The Eagles American English Club, Ltd.",
  "license": "Copyright © 2026 | The Eagles American English Club, Ltd. | All rights reserved",
  "bugs": {},
  "homepage": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.18.2",
    "@types/node": "^20.19.35",
    "axe-core": "^4.11.3",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "html-validate": "^10.11.3",
    "html-validate-markdown": "^5.1.0",
    "html-validate-vue": "^8.1.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.59.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "prisma": "^7.7.0",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "uglify-js": "^3.19.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "archiver": "^7.0.1",
    "argparse": "^2.0.1",
    "cheerio": "^1.2.0",
    "css-declaration-sorter": "^7.4.0",
    "cssnano": "^7.1.4",
    "dom-serializer": "^2.0.0",
    "dotenv": "^17.4.1",
    "fast-xml-parser": "^5.7.2",
    "glob": ">=11.1.0",
    "js-yaml": "^4.1.1",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.11",
    "redis": "^5.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "brace-expansion@^2.0.0": "2.0.3",
    "hono": ">=4.12.14",
    "dompurify": "3.4.1",
    "lodash": "4.18.0",
    "protobufjs": "7.5.5",
    "styled-components": "6.4.1"
  }
}

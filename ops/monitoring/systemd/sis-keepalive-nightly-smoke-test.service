[Unit]
Description=Run the full isolated SIS test-mirror keep-alive smoke suite
After=network.target

[Service]
Type=oneshot
User=eagles
Group=eagles
WorkingDirectory=/home/eagles/dockerz/sis
Environment=SIS_ENV_FILE=.env.test
Environment=DOTENV_CONFIG_PATH=.env.test
Environment=NODE_ENV=test
Environment=SIS_KEEPALIVE_NO_EXTERNAL_MESSAGES=1
ExecStart=/home/eagles/.nvm/versions/node/v22.22.1/bin/node --env-file=.env.test tools/run-keepalive-nightly-smoke.mjs
TimeoutStartSec=5h
TimeoutStopSec=30s
Nice=10
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

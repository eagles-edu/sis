[Unit]
Description=Run the authenticated synthetic SIS test parent profile workflow monitor
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/eagles/dockerz/sis
Environment=SIS_ENV_FILE=.env.test
Environment=DOTENV_CONFIG_PATH=.env.test
Environment=NODE_ENV=test
ExecStart=/bin/bash -lc 'cd /home/eagles/dockerz/sis && npm run monitor:parent-profile:test'
TimeoutStartSec=120s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/eagles/dockerz/sis/runtime-data/prometheus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

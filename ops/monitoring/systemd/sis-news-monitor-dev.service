[Unit]
Description=Run authenticated SIS dev Student News workflow monitor
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/eagles/dockerz/sis
ExecStart=/bin/bash -lc 'cd /home/eagles/dockerz/sis && npm run monitor:news:dev'
TimeoutStartSec=90s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/eagles/dockerz/sis/runtime-data/prometheus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

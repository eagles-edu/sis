[Unit]
Description=Check live SIS and LTD database and Redis dependencies for Prometheus
After=default.target

[Service]
Type=oneshot
WorkingDirectory=/home/eagles/dockerz/sis
ExecStart=/usr/bin/python3 /home/eagles/dockerz/sis/ops/monitoring/monitor-site-dependencies.py
TimeoutStartSec=30s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/eagles/dockerz/sis/runtime-data/prometheus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Unit]
Description=Collect local CrowdSec and Fail2ban dashboard metrics
After=network.target crowdsec.service crowdsec-firewall-bouncer.service fail2ban.service
Wants=crowdsec.service crowdsec-firewall-bouncer.service fail2ban.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
ExecStart=/usr/local/libexec/eagles-security-monitoring-metrics.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/eagles/dockerz/sis/runtime-data/prometheus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=25s

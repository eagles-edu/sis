[Unit]
Description=Check configured SIS vendor APIs with read-only health requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/eagles/dockerz/sis
ExecStart=/usr/bin/python3 /home/eagles/dockerz/sis/ops/monitoring/monitor-vendor-health.py
TimeoutStartSec=120s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/eagles/dockerz/sis/runtime-data/prometheus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Unit]
Description=Read-only SIS dev engagement workflow monitor
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/eagles/dockerz/sis
ExecStartPre=/home/eagles/.nvm/versions/node/v22.22.1/bin/node tools/wait-for-dev-api-listener.mjs
ExecStart=/bin/bash -lc 'cd /home/eagles/dockerz/sis && npm run monitor:engagement:dev'
TimeoutStartSec=90s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/eagles/dockerz/sis/runtime-data/prometheus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

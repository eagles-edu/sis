discovery.docker "monitoring" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "1m"

	filter {
		name   = "name"
		values = [
			"/sis-prometheus",
			"/sis-alertmanager",
			"/sis-grafana",
			"/sis-blackbox-exporter",
			"/sis-node-exporter",
			"/sis-process-exporter",
			"/sis-redis-exporter",
			"/sis-cadvisor",
			"/sis-loki",
			"/sis-alloy",
		]
	}
}

loki.source.docker "monitoring" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.docker.monitoring.targets
	labels     = {job = "monitoring-containers"}
	forward_to = [loki.process.monitoring.receiver]
}

loki.process "monitoring" {
	stage.docker { }

	stage.drop {
		older_than          = "30m"
		drop_counter_reason = "stale_docker_backlog"
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

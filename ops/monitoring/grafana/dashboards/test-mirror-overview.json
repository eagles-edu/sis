    {
      "id": 7,
      "type": "text",
      "title": "Monitoring schedule",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Test schedules ten authenticated workflow checks: engagement, assignment notifications, parent reports, and profile/enrollment every 60s; parent profile every 15m; Library, Dictionary Builder, News, grades/feeds, and attendance every 5m; full no-send suite nightly at 04:00 ICT. Read-only vendor health runs every 15m."
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Subsystem smoke results",
      "gridPos": {
        "h": 16,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "label_replace(sis_keepalive_check_success{environment=\"test\",group=\"engagement\"}, \"subsystem\", \"engagement\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"assignment_notifications\"}, \"subsystem\", \"assignment_notifications\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"parent_reports\"}, \"subsystem\", \"parent_reports\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"student_profile_enrollment\"}, \"subsystem\", \"student_profile_enrollment\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"parent_profile\"}, \"subsystem\", \"parent_profile\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"student_library\"}, \"subsystem\", \"student_library\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"dictionary_builder\"}, \"subsystem\", \"dictionary_builder\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"student_news\"}, \"subsystem\", \"student_news\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"grade_feeds\"}, \"subsystem\", \"grade_feeds\", \"__name__\", \".*\") or label_replace(sis_keepalive_check_success{environment=\"test\",group=\"attendance\"}, \"subsystem\", \"attendance\", \"__name__\", \".*\")",
          "refId": "A",
          "legendFormat": "{{subsystem}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red"
                },
                "1": {
                  "text": "PASS",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      }
    },

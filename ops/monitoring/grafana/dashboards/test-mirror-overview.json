{
  "uid": "sis-test-mirror-overview",
  "title": "SIS Test Mirror Health",
  "tags": ["sis", "test-mirror", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Public admin probe",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "probe_success{job=\"blackbox-test-mirror\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Public admin response time",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "probe_duration_seconds{job=\"blackbox-test-mirror\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Test API process",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "node_systemd_unit_state{name=\"exercise-mailer-test.service\",state=\"active\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Test Node runtime",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "count(node_systemd_unit_state{name=\"exercise-mailer-test.service\",state=\"active\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Student-save latency by stage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le,stage) (rate(sis_admin_student_write_stage_duration_seconds_bucket[10m])))", "legendFormat": "p95 {{stage}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SIS runtime RSS",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "sis_nodejs_rss_bytes", "legendFormat": "RSS", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host CPU and memory pressure",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "targets": [
        {"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))", "legendFormat": "Host CPU", "refId": "A"},
        {"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "Host memory", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Optional Redis diagnostics",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21},
      "targets": [
        {"expr": "redis_memory_used_bytes", "legendFormat": "Redis memory", "refId": "A"},
        {"expr": "redis_connected_clients", "legendFormat": "Redis clients", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}

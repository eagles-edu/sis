{
  "uid": "sis-resource-overview",
  "title": "SIS Resource Overview",
  "tags": ["sis", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Host CPU usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Host memory used",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Host load average",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "node_load1", "legendFormat": "1 minute", "refId": "A"}, {"expr": "node_load5", "legendFormat": "5 minutes", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Swap and root filesystem",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes", "legendFormat": "swap used", "refId": "A"}, {"expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "root free", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Student-write request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum by (environment) (rate(sis_admin_student_write_requests_total[5m])) or vector(0)", "legendFormat": "{{environment}} writes/s", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "noValue": "No instrumented writes in this range"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Student-save mean latency by stage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum by (environment,phase) (rate(sis_admin_student_write_phase_duration_seconds_sum[10m])) / sum by (environment,phase) (rate(sis_admin_student_write_phase_duration_seconds_count[10m]))", "legendFormat": "{{environment}} · {{phase}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "No authenticated saves in this range"}, "overrides": []}
    }
  ]
}

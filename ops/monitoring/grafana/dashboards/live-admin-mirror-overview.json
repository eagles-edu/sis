    {
      "id": 7,
      "type": "text",
      "title": "Monitoring schedule",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Live runs ten read-only smoke probes: public page, SIS API, auth guard, service, PostgreSQL container/query, three Redis roles, and grade-feed aggregate query. Dependency checks run every 60s; configured vendor health runs every 15m. No customer workflow writes or messages are generated."
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Subsystem smoke results",
      "gridPos": {
        "h": 16,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "label_replace(probe_success{job=\"blackbox-website-http\",site=\"admin\"}, \"subsystem\", \"Public admin page\", \"__name__\", \".*\") or label_replace(probe_success{job=\"blackbox-website-api\",site=\"admin\",check=\"sis-api\"}, \"subsystem\", \"SIS API route\", \"__name__\", \".*\") or label_replace(probe_success{job=\"blackbox-admin-auth-api\",site=\"admin\"}, \"subsystem\", \"Auth guard\", \"__name__\", \".*\") or label_replace(node_systemd_unit_state{name=\"exercise-mailer.service\",state=\"active\"}, \"subsystem\", \"SIS API service\", \"__name__\", \".*\") or label_replace(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-postgres\",check=\"container-running\"}, \"subsystem\", \"PostgreSQL container\", \"__name__\", \".*\") or label_replace(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-postgres\",check=\"authenticated-select-1\"}, \"subsystem\", \"PostgreSQL SELECT 1\", \"__name__\", \".*\") or label_replace(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-app\",check=\"authenticated-ping\"}, \"subsystem\", \"Redis app role\", \"__name__\", \".*\") or label_replace(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-sessions\",check=\"authenticated-ping\"}, \"subsystem\", \"Redis sessions role\", \"__name__\", \".*\") or label_replace(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-cache\",check=\"authenticated-ping\"}, \"subsystem\", \"Redis cache role\", \"__name__\", \".*\") or label_replace(sis_grade_feed_readonly_data_available{environment=\"live\"}, \"subsystem\", \"Grade/feed read-only query\", \"__name__\", \".*\")",
          "refId": "A",
          "legendFormat": "{{subsystem}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red"
                },
                "1": {
                  "text": "PASS",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      }

      "targets": [
        {
          "expr": "(count(probe_success{job=\"blackbox-website-http\",site=\"admin\"}) or vector(0)) + (count(probe_success{job=\"blackbox-website-api\",site=\"admin\",check=\"sis-api\"}) or vector(0)) + (count(probe_success{job=\"blackbox-admin-auth-api\",site=\"admin\"}) or vector(0)) + (count(node_systemd_unit_state{name=\"exercise-mailer.service\",state=\"active\"}) or vector(0)) + (count(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-postgres\",check=\"container-running\"}) or vector(0)) + (count(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-postgres\",check=\"authenticated-select-1\"}) or vector(0)) + (count(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-app\",check=\"authenticated-ping\"}) or vector(0)) + (count(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-sessions\",check=\"authenticated-ping\"}) or vector(0)) + (count(site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-cache\",check=\"authenticated-ping\"}) or vector(0)) + (count(sis_grade_feed_readonly_data_available{environment=\"live\"}) or vector(0))",

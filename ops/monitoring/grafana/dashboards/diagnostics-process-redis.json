{
  "uid":"diagnostics-process-redis","title":"On-demand Diagnostics: Processes and Redis","tags":["diagnostics","process","redis"],"timezone":"browser","schemaVersion":39,"refresh":"5s","time":{"from":"now-1h","to":"now"},
  "panels":[
    {"id":1,"type":"text","title":"Measured coverage","gridPos":{"h":4,"w":24,"x":0,"y":0},"options":{"mode":"markdown","content":"SIS process CPU/RSS and live/test Redis role status, ping latency, and shared-container CPU/memory are sampled continuously. Redis memory/client/command metrics require a separately secured exporter and are not collected. LiteSpeed traffic remains unavailable until its official exporter is installed."}},
    {"id":2,"type":"timeseries","title":"Named process CPU","gridPos":{"h":8,"w":12,"x":0,"y":4},"targets":[{"expr":"100 * rate(namedprocess_namegroup_cpu_seconds_total[1m])","legendFormat":"{{groupname}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":3,"type":"timeseries","title":"Named process RSS","gridPos":{"h":8,"w":12,"x":12,"y":4},"targets":[{"expr":"namedprocess_namegroup_memory_bytes","legendFormat":"{{groupname}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Live Redis session role","gridPos":{"h":5,"w":6,"x":0,"y":12},"targets":[{"expr":"site_dependency_status{environment=\"live\",domain=\"admin.eagles.edu.vn\",dependency=\"sis-sessions\",check=\"authenticated-ping\"}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]}},
    {"id":5,"type":"stat","title":"Test Redis session role","gridPos":{"h":5,"w":6,"x":6,"y":12},"targets":[{"expr":"site_dependency_status{environment=\"test\",domain=\"test.eagles.edu.vn\",dependency=\"sis-sessions\",check=\"authenticated-ping\"}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]}},
    {"id":6,"type":"stat","title":"Redis container CPU","gridPos":{"h":5,"w":6,"x":12,"y":12},"targets":[{"expr":"site_dependency_container_cpu_percent{container=\"redis\"}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":7,"type":"stat","title":"Redis container memory","gridPos":{"h":5,"w":6,"x":18,"y":12},"targets":[{"expr":"site_dependency_container_memory_used_bytes{container=\"redis\"}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":8,"type":"timeseries","title":"Redis authenticated ping latency by environment and role","gridPos":{"h":8,"w":24,"x":0,"y":17},"targets":[{"expr":"site_dependency_probe_duration_seconds{dependency=~\"sis-(app|sessions|cache)\",check=\"authenticated-ping\"}","legendFormat":"{{environment}} · {{dependency}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}}
  ]

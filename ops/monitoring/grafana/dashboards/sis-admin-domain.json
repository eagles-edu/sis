    {
      "id": 19,
      "type": "stat",
      "title": "24h uptime",
      "description": "The success rate is calculated from samples actually collected in the last 24 hours. The sample count sits beside the rate so incomplete history is visible; no data is not treated as healthy.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "sis-prometheus"
      },
      "targets": [
        {
          "expr": "100 * avg_over_time(probe_success{job=\"blackbox-website-http\",domain=\"admin.eagles.edu.vn\",check=\"main\"}[24h])",
          "refId": "A",
          "legendFormat": "Success %",
          "instant": true
        },
        {
          "expr": "count_over_time(probe_success{job=\"blackbox-website-http\",domain=\"admin.eagles.edu.vn\",check=\"main\"}[24h])",
          "refId": "B",
          "legendFormat": "Samples",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Success %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 99
                    },
                    {
                      "color": "green",
                      "value": 99.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "green",
                      "value": 1200
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }

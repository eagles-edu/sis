{
  "uid":"sis-operations","title":"SIS Operations","tags":["sis","operations"],"timezone":"browser","schemaVersion":39,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"Student writes (5m)","gridPos":{"h":5,"w":6,"x":0,"y":0},"targets":[{"expr":"sum(increase(sis_admin_student_write_requests_total[5m]))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":2,"type":"stat","title":"Student-write p95","gridPos":{"h":5,"w":6,"x":6,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(sis_admin_student_write_duration_seconds_bucket[10m])))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":3,"type":"stat","title":"SIS RSS","gridPos":{"h":5,"w":6,"x":12,"y":0},"targets":[{"expr":"sis_nodejs_rss_bytes","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Test admin public probe","gridPos":{"h":5,"w":6,"x":18,"y":0},"targets":[{"expr":"probe_success{job=\"blackbox-test-mirror\"}","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]},"overrides":[]}},
    {"id":5,"type":"timeseries","title":"Student save latency by stage","gridPos":{"h":8,"w":24,"x":0,"y":5},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,stage) (rate(sis_admin_student_write_stage_duration_seconds_bucket[10m])))","legendFormat":"p95 {{stage}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"Student writes and failures","gridPos":{"h":8,"w":12,"x":0,"y":13},"targets":[{"expr":"sum(rate(sis_admin_student_write_requests_total[5m]))","legendFormat":"writes/s","refId":"A"},{"expr":"sum(rate(sis_admin_student_write_requests_total{status!~\"2..\"}[5m]))","legendFormat":"failed/s","refId":"B"}],"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]}},
    {"id":7,"type":"timeseries","title":"SIS process memory","gridPos":{"h":8,"w":12,"x":12,"y":13},"targets":[{"expr":"sis_nodejs_rss_bytes","legendFormat":"RSS","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":8,"type":"timeseries","title":"Test mirror probe phases","gridPos":{"h":8,"w":24,"x":0,"y":21},"targets":[{"expr":"probe_http_duration_seconds{job=\"blackbox-test-mirror\"}","legendFormat":"{{phase}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}}
  ]
}

{
  "uid":"ubuntu-host-overview","title":"Ubuntu Host Overview","tags":["ubuntu","host","operations"],"timezone":"browser","schemaVersion":39,"refresh":"15s","time":{"from":"now-6h","to":"now"},
  "panels":[
    {"id":1,"type":"stat","title":"CPU now","gridPos":{"h":5,"w":6,"x":0,"y":0},"targets":[{"expr":"100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","max":100,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":75},{"color":"red","value":90}]}},"overrides":[]}},
    {"id":2,"type":"stat","title":"Memory available","gridPos":{"h":5,"w":6,"x":6,"y":0},"targets":[{"expr":"100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","max":100},"overrides":[]}},
    {"id":3,"type":"stat","title":"Swap used","gridPos":{"h":5,"w":6,"x":12,"y":0},"targets":[{"expr":"node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Disk free","gridPos":{"h":5,"w":6,"x":18,"y":0},"targets":[{"expr":"node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":5,"type":"timeseries","title":"CPU by mode","gridPos":{"h":8,"w":12,"x":0,"y":5},"targets":[{"expr":"100 * sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))","legendFormat":"{{mode}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"Memory, swap and filesystem pressure","gridPos":{"h":8,"w":12,"x":12,"y":5},"targets":[{"expr":"100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)","legendFormat":"memory used","refId":"A"},{"expr":"100 * (1 - node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes)","legendFormat":"swap used","refId":"B"},{"expr":"100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})","legendFormat":"root filesystem used","refId":"C"}],"fieldConfig":{"defaults":{"unit":"percent","max":100},"overrides":[]}},
    {"id":7,"type":"timeseries","title":"Disk IO and network throughput","gridPos":{"h":8,"w":24,"x":0,"y":13},"targets":[{"expr":"sum(rate(node_disk_read_bytes_total[5m]))","legendFormat":"disk read","refId":"A"},{"expr":"sum(rate(node_disk_written_bytes_total[5m]))","legendFormat":"disk write","refId":"B"},{"expr":"sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[5m]))","legendFormat":"network receive","refId":"C"},{"expr":"sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[5m]))","legendFormat":"network transmit","refId":"D"}],"fieldConfig":{"defaults":{"unit":"Bps"},"overrides":[]}},
    {"id":8,"type":"table","title":"Required services","gridPos":{"h":8,"w":24,"x":0,"y":21},"targets":[{"expr":"node_systemd_unit_state{name=~\"(lshttpd|lscpd|redis-server|exercise-mailer.*)\\.service\",state=\"active\"}","format":"table","refId":"A"}],"transformations":[{"id":"reduce","options":{"reducers":["lastNotNull"]}}]}
  ]
}

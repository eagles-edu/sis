[Unit]
Description=Dispatch idempotent SIS assignment reminders
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{RUNTIME_ROOT}}
EnvironmentFile={{ENV_FILE}}
Environment=DOTENV_CONFIG_PATH={{ENV_FILE}}
ExecStart={{NODE_BIN}} -r dotenv/config {{SOURCE_ROOT}}/tools/run-assignment-reminder-dispatcher.mjs

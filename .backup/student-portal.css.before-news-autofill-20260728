    .news-sentence-feedback {
      display: grid;
      gap: 6px;
      margin-top: 10px;
    }

    .news-sentence-feedback h4 {
      margin: 0;
    }

    .news-sentence-raw {
      white-space: pre-wrap;
    }

    .news-sentence-error {
      text-decoration: underline wavy #b3262d 2px;
      text-decoration-skip-ink: none;
      text-underline-offset: 3px;
    }

    .news-sentence-comments {
      margin: 0;
      padding-left: 20px;
    }

    .status-strip {
      padding: 10px 12px;
    }

    .news-compliance-success,
    .news-feedback-empty-success {
      color: #167447;
      font-weight: 900;
    }

    .submit-success-modal {
      isolation: isolate;
      z-index: 1250;
    }

    .submit-success-modal .portal-modal-backdrop {
      z-index: 0;
    }

    .submit-success-confetti {
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      position: fixed;
      z-index: 3;
    }

    .submit-success-confetti-burst {
      inset: 50% auto auto 50%;
      position: absolute;
      transform: translate(-50%, -50%);
    }

    .submit-success-confetti-piece {
      animation: submit-success-confetti-burst 4.2s cubic-bezier(.16, .84, .24, 1) calc(var(--burst-delay, 0ms) + var(--piece-delay, 0ms)) infinite;
      background: var(--piece-color, var(--portal-status-good-border));
      border-radius: 999px;
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.48), 0 0 14px color-mix(in srgb, var(--piece-color) 72%, transparent);
      filter: saturate(1.45) drop-shadow(0 2px 4px rgba(8, 22, 40, 0.32));
      height: var(--piece-height, 14px);
      left: calc(var(--piece-width, 10px) / -2);
      opacity: 0;
      position: absolute;
      top: calc(var(--piece-height, 14px) / -2);
      transform: rotate(var(--piece-angle, 0deg)) translateX(0) rotate(0deg);
      transform-origin: center;
      width: var(--piece-width, 10px);
    }

    .submit-success-dialog {
      max-inline-size: min(92vw, 420px);
      position: relative;
      text-align: center;
      z-index: 4;
    }

    .submit-success-body {
      display: grid;
      gap: 12px;
      justify-items: center;
      padding-block: 10px 4px;
    }

    .submit-success-mark {
      align-items: center;
      background: linear-gradient(180deg, color-mix(in srgb, var(--portal-status-good-bg) 88%, #fff 12%), var(--portal-status-good-bg));
      block-size: 72px;
      border: 2px solid var(--portal-status-good-border);
      border-radius: 999px;
      box-shadow: 0 16px 30px rgba(21, 95, 63, 0.18);
      color: var(--portal-status-good-text);
      display: inline-flex;
      font-size: 36px;
      font-weight: 900;
      inline-size: 72px;
      justify-content: center;
      line-height: 1;
    }

    .submit-success-title {
      font-size: 1.18rem;
      font-weight: 800;
      line-height: 1.2;
      margin: 0;
    }

    .submit-success-copy {
      margin: 0;
      max-inline-size: 28ch;
    }

    .news-feedback-report {
      display: grid;
      gap: 12px;
      margin-bottom: 6px;
    }

    .news-feedback-note,
    .news-feedback-deadline {
      background: var(--portal-surface-support);
      border: 1px solid var(--portal-border);
      border-radius: var(--radius-2);
      color: var(--portal-text);
      font-size: 1rem;
      line-height: 1.6;
      margin: 0;
      padding: 12px 14px;
    }

    .news-feedback-deadline {
      font-weight: 700;
    }

    .news-feedback-note {
      white-space: pre-wrap;
    }

    .news-feedback-section {
      display: grid;
      gap: 8px;
    }

    .news-feedback-section h5 {
      font-size: 1rem;
      margin: 0;
    }

    .news-feedback-table {
      border-collapse: separate;
      border-spacing: 0;
      font-size: 0.98rem;
      line-height: 1.55;
      width: 100%;
    }

    .news-feedback-table th,
    .news-feedback-table td {
      border-bottom: 1px solid var(--portal-border);
      padding: 10px 12px;
      text-align: left;
      vertical-align: top;
    }

    .news-feedback-table thead th {
      background: var(--portal-surface-support);
      font-size: 0.86rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .news-feedback-table tbody tr:last-child td {
      border-bottom: none;
    }

    @keyframes submit-success-confetti-burst {
      0% {
        opacity: 0;
        transform: rotate(var(--piece-angle, 0deg)) translateX(0) rotate(0deg) scale(.35);
      }

      12%,
      76% {
        opacity: .98;
      }

      100% {
        opacity: 0;
        transform: rotate(var(--piece-angle, 0deg)) translateX(var(--piece-distance, 220px)) rotate(var(--piece-rotate-end, 360deg)) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .submit-success-confetti {
        display: none;
      }
    }

    .row {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .queue-summary-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .summary-title {
      display: block;
      font-weight: 800;
      font-size: 1rem;
      line-height: 1.2;
    }

    .queue-table-wrap {
      padding: 6px;
      max-height: 260px;
      overflow: auto;
      box-sizing: border-box;
      min-width: 0;
    }

    .queue-table-wrap table {
      min-width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      table-layout: fixed;
      width: 100%;
    }

    .queue-table-wrap th,
    .queue-table-wrap td {
      padding: 6px 8px;
      text-align: left;
      vertical-align: top;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .queue-table-wrap tr:last-child td {
      border-bottom: none;
    }

    .queue-table-wrap .link-btn {
      padding: 6px 10px;
      min-height: 0;
      font-size: 12px;
    }

    .queue-table-wrap .cell-actions {
      white-space: nowrap;
    }

    .queue-table-wrap table.news-queue-table {
      table-layout: auto;
    }

    .queue-table-wrap table.news-queue-table th,
    .queue-table-wrap table.news-queue-table td {
      padding: 4px 6px;
    }

    .queue-table-wrap table.news-queue-table th:nth-child(2),
    .queue-table-wrap table.news-queue-table td:nth-child(2),
    .queue-table-wrap table.news-queue-table th:nth-child(3),
    .queue-table-wrap table.news-queue-table td:nth-child(3),
    .queue-table-wrap table.news-queue-table th:nth-child(5),
    .queue-table-wrap table.news-queue-table td:nth-child(5) {
      white-space: nowrap;
    }

    .queue-table-wrap table.news-queue-table td:nth-child(3) .chip,
    table.news-queue-table td:nth-child(3) .chip {
      --chip-height: 24px;
      --chip-min-ar: 0;
      min-inline-size: 0;
      padding: 0 8px;
      font-size: 11px;
    }

    table.news-queue-table td:nth-child(3) .chip {
      min-inline-size: 0;
    }

    @media (max-width: 920px) {

      .queue-table-wrap table.news-queue-table th:nth-child(4),
      .queue-table-wrap table.news-queue-table td:nth-child(4) {
        display: none;
      }
    }

    @media (max-width: 620px) {

      .queue-table-wrap table.news-queue-table th:nth-child(2),
      .queue-table-wrap table.news-queue-table td:nth-child(2) {
        display: none;
      }
    }

    @media (max-width: 520px) {
      .queue-table-wrap table.news-queue-table {
        table-layout: auto;
      }

      .queue-table-wrap table.news-queue-table thead {
        display: none;
      }

      .queue-table-wrap table.news-queue-table th:nth-child(2),
      .queue-table-wrap table.news-queue-table td:nth-child(2),
      .queue-table-wrap table.news-queue-table th:nth-child(3),
      .queue-table-wrap table.news-queue-table td:nth-child(3),
      .queue-table-wrap table.news-queue-table th:nth-child(4),
      .queue-table-wrap table.news-queue-table td:nth-child(4) {
        display: none;
      }

      .queue-table-wrap table.news-queue-table tbody {
        display: grid;
        gap: 8px;
      }

      .queue-table-wrap table.news-queue-table tbody tr {
        display: grid;
        gap: 6px;
        grid-template-columns: minmax(0, 1fr);
        border-radius: var(--radius-2);
        padding: 8px;
      }

      .queue-table-wrap table.news-queue-table tbody td {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        border-bottom: 0;
        padding: 0;
      }

      .queue-table-wrap table.news-queue-table tbody td:nth-child(1) {
        font-weight: 700;
      }
      .queue-table-wrap table.news-queue-table tbody td[colspan] {
        display: block;
        text-align: center;
      }
    }


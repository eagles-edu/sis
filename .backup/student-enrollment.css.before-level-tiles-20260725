:root {
      --font-base:
        system-ui, -apple-system, blinkmacsystemfont, "Segoe UI Variable", "Segoe UI", roboto, "Noto Sans", ubuntu, cantarell, "Liberation Sans", "DejaVu Sans", "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
      --enrollment-shell-max: 1280px;
      --enrollment-table-head-bg: linear-gradient(180deg, color-mix(in srgb, var(--portal-surface-card) 92%, var(--brand) 8%), var(--portal-surface-card));
      --enrollment-table-row-alt: color-mix(in srgb, var(--portal-surface-soft) 78%, #ffffff 22%);
    }

    html {
      background: var(--portal-page-bg);
      font-size: calc(16px * var(--sis-global-text-zoom, 1));
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: var(--portal-page-bg);
      color: var(--portal-text);
      display: flex;
      flex-direction: column;
      font-family: var(--font-base, system-ui, -apple-system, sans-serif);
      margin: 0;
      min-height: 100vh;
    }

    .hidden {
      display: none !important;
    }

    html[data-admin-auth-state="authenticated"] #app {
      display: block !important;
    }

    html[data-admin-auth-state="authenticated"] #sessionRequiredPanel {
      display: none !important;
    }

    html[data-admin-auth-state="unauthenticated"] #app {
      display: none !important;
    }

    html[data-admin-auth-state="unauthenticated"] #sessionRequiredPanel {
      display: block !important;
    }

    .wrap {
      display: grid;
      gap: var(--portal-shell-gap);
      margin: 0 auto;
      max-width: 1440px;
      padding: clamp(12px, 2.8vw, 16px);
      width: min(100%, 1440px);
    }

    .enrollment-shell {
      --portal-center-column-max: var(--enrollment-shell-max);
      display: grid;
      gap: var(--portal-shell-gap);
    }

    .app-brand-copy {
      display: grid;
      gap: 4px;
      min-width: 0;
    }

    #sessionRequiredPanel {
      justify-self: center;
      width: min(100%, var(--portal-login-panel-max-width));
    }

    .session-required-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
    }

    .session-required-actions a {
      text-decoration: none;
    }

    #appMain {
      display: grid;
      gap: clamp(12px, 2vw, 16px);
    }

    .row {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field label {
      font-size: 0.82rem;
      font-weight: 700;
    }

    .field-inline {
      align-items: center;
      display: inline-flex;
      gap: 8px;
      min-height: 48px;
    }

    .field-inline input[type="checkbox"] {
      inline-size: auto;
      margin: 0;
    }

    .c2,
    .c3,
    .c4,
    .c6 {
      grid-column: span 12;
    }

    .c12 {
      grid-column: span 12;
    }

    input,
    select,
    button {
      font: inherit;
    }

    input:not([type="checkbox"]),
    select,
    button,
    textarea {
      min-height: 48px;
      padding: 10px 12px;
    }

    .enrollment-summary-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr;
    }

    .enrollment-summary-card {
      display: grid;
      gap: 4px;
      min-width: 0;
      padding: 7px;
    }

    .enrollment-summary-card p {
      margin: 0;
    }

    .enrollment-summary-value {
      font-size: clamp(1.4rem, 1rem + 0.95vw, 1.75rem);
      font-variant-numeric: tabular-nums;
      font-weight: 900;
      line-height: 1.05;
    }

    .status-cell-stack {
      display: grid;
      gap: 8px;
      min-width: 0;
    }

    .status-chip-row--compact {
      gap: 4px;
    }

    .table-wrap {
      border: 1px solid var(--portal-border);
      border-radius: var(--radius-3);
      max-width: 100%;
      min-width: 0;
      overflow: auto;
      width: 100%;
    }

    table {
      border-collapse: collapse;
      min-width: 1080px;
      width: 100%;
    }

    thead th {
      background: var(--enrollment-table-head-bg);
      border-bottom: 1px solid var(--portal-border);
      color: var(--portal-text);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      padding: 11px 10px;
      position: sticky;
      text-align: left;
      text-transform: uppercase;
      top: 0;
      vertical-align: top;
      z-index: 1;
    }

    tbody td {
      border-top: 1px solid var(--border-strong);
      border-bottom: 1px solid var(--border-strong);
      padding: 12px 10px;
      text-align: left;
      vertical-align: top;
    }

    tbody tr:nth-child(even) {
      background: var(--enrollment-table-row-alt);
    }

    .student-ident {
      display: grid;
      gap: 4px;
    }

    .student-ident strong {
      font-size: 0.98rem;
    }

    .student-ident small:first-of-type {
      max-inline-size: 52%;
      overflow-wrap: normal;
      white-space: normal;
      word-break: normal;
    }

    .enrollment-chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .status-chip-row {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .history-stack {
      display: grid;
      gap: 8px;
    }

    .action-cell-layout {
      align-items: start;
      display: grid;
      gap: 10px;
      grid-template-columns: minmax(0, 1fr);
      min-width: 0;
    }

    .history-rail {
      align-items: start;
      align-self: stretch;
      display: grid;
      gap: 0;
      justify-items: center;
      justify-self: end;
      min-width: 28px;
      white-space: nowrap;
      position: relative;
      padding-top: 2px;
    }

    body.student-enrollment-page .history-rail__button {
      appearance: none;
      align-items: center;
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      color: inherit !important;
      display: inline-flex;
      justify-content: center;
      min-height: 0 !important;
      min-width: 0 !important;
      padding: 0 !important;
      width: auto;
    }

    html[data-theme="dark"] body.student-enrollment-page .history-rail__button,
    html[data-theme="dark"] body.student-enrollment-page .history-rail__button .history-rail__dots {
      color: var(--secondary-color) !important;
    }

    body.student-enrollment-page .history-rail__button:hover,
    body.student-enrollment-page .history-rail__button:active,
    body.student-enrollment-page .history-rail__button:focus-visible {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
      transform: none !important;
    }

    body.student-enrollment-page .history-rail__button:focus-visible {
      outline: 2px solid var(--portal-border-strong);
      outline-offset: 2px;
    }

    body.student-enrollment-page .history-rail__button .history-rail__dots {
      color: inherit;
      display: inline-flex;
      font-size: 1.2rem;
      line-height: 1;
      transform: translateY(-1px);
    }

    .history-rail__menu {
      background: var(--portal-surface-card);
      border: 1px solid var(--portal-border);
      border-radius: var(--radius-2);
      box-shadow: var(--portal-panel-shadow-strong);
      display: grid;
      gap: 6px;
      min-width: 168px;
      max-width: min(240px, calc(100vw - 24px));
      padding: 8px;
      position: absolute;
      right: calc(100% + 8px);
      top: 0;
      z-index: 4;
    }

    .history-rail__menu.hidden {
      display: none !important;
    }

    .history-rail__menu button:not(.portal-button) {
      background: #1d4999 !important;
      border: 1px solid var(--portal-border) !important;
      color: var(--secondary-color)#f9faff !important;
      justify-content: flex-start;
      min-height: 36px;
      padding-inline: 10px;
      width: 100%;
    }

    .action-stack {
      display: grid;
      gap: 8px;
    }

    .action-grid {
      display: grid;
      gap: 8px;
      grid-template-columns: minmax(0, 1fr);
    }

    .action-grid > * {
      min-width: 0;
    }

    .action-comment-row {
      align-items: start;
      display: grid;
      gap: 8px;
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) auto;
      min-width: 0;
      width: 100%;
    }

    .action-comment-row .comment-input {
      inline-size: auto;
      grid-column: 1;
      min-width: 0;
      padding-inline-end: 12px;
      width: 100%;
    }

    .action-comment-row .history-rail {
      align-self: start;
      grid-column: 2;
      justify-self: end;
      min-width: 0;
      padding-top: 0;
      width: auto;
    }

    .comment-input {
      inline-size: 100%;
      max-inline-size: 100%;
      min-block-size: 46px;
      min-width: 0;
      overflow-y: hidden;
      resize: vertical;
      width: 100%;
    }

    .action-comment {
      grid-column: 1 / -1;
    }

    .table-empty {
      color: var(--portal-text-soft);
      padding: 20px 12px;
      text-align: center;
    }

    .enrollment-history-modal {
      align-items: center;
      inset: 0;
      display: grid;
      justify-items: center;
      padding: clamp(12px, 3vw, 28px);
      position: fixed;
      z-index: 1000;
    }

    .enrollment-history-modal.hidden {
      display: none !important;
    }

    body.modal-open {
      overflow: hidden;
    }

    .enrollment-history-modal__backdrop {
      background: var(--portal-modal-backdrop);
      inset: 0;
      position: absolute;
    }

    .enrollment-history-modal__panel {
      display: grid;
      gap: 14px;
      max-height: min(78vh, 620px);
      max-width: 560px;
      overflow: auto;
      padding: 16px;
      position: relative;
      width: min(100%, 560px);
      z-index: 1;
    }

    .enrollment-history-modal__header {
      align-items: start;
      display: flex;
      gap: 12px;
      justify-content: space-between;
    }

    .enrollment-history-modal__close {
      background: var(--portal-surface-soft);
      border: 1px solid var(--portal-border);
      color: var(--portal-text);
      min-height: 36px;
      padding-inline: 10px;
      white-space: nowrap;
    }

    .enrollment-history-modal__list {
      display: grid;
      gap: 8px;
    }

    .enrollment-history-period {
      display: grid;
      gap: 6px;
      padding: 10px 11px;
    }

    .enrollment-history-period__head {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .enrollment-history-period__meta {
      display: grid;
      gap: 4px;
    }

    .enrollment-history-period__note {
      background: var(--portal-surface-soft);
      border: 1px solid var(--portal-border);
      border-radius: var(--radius-2);
      color: var(--portal-text);
      margin: 0;
      padding: 8px 10px;
    }

    .header-bar,
    .hub-footer {
      margin-inline: auto;
      width: min(var(--portal-center-column-max, var(--enrollment-shell-max)), 100%);
    }

    .hub-footer {
      margin-top: auto;
    }

    html[data-theme="dark"] body.admin-portal-page {
      background: var(--portal-dark-page-bg);
      color: var(--portal-dark-text);
    }

    html[data-theme="dark"] .student-ident strong,
    html[data-theme="dark"] thead th,
    html[data-theme="dark"] .enrollment-summary-value {
      color: var(--portal-dark-text);
    }

    html[data-theme="dark"] .portal-theme-card,
    html[data-theme="dark"] .portal-theme-panel,
    html[data-theme="dark"] .table-wrap {
      border-color: var(--portal-dark-border);
    }
    html[data-theme="dark"] tbody td {
      border-top-color: var(--portal-dark-border-strong);
      border-bottom-color: var(--portal-dark-border-strong);
    }

    @media (min-width: 720px) {
      .c2 {
        grid-column: span 2;
      }

      .c3 {
        grid-column: span 3;
      }

      .c4 {
        grid-column: span 4;
      }

      .c6 {
        grid-column: span 6;
      }

      .enrollment-summary-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .action-grid {
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr) auto;
      }
    }

    @media (min-width: 980px) {
    }

    @media (min-width: 821px) and (max-width: 1150px) {
      .table-wrap {
        overflow-x: auto;
      }

      table {
        min-width: 0;
        table-layout: auto;
        width: 100%;
      }

      thead th:nth-child(1),
      tbody td:nth-child(1) {
        width: 1%;
        white-space: nowrap;
      }

      thead th:nth-child(2),
      tbody td:nth-child(2) {
        width: 1%;
        white-space: nowrap;
      }

      thead th:nth-child(3),
      tbody td:nth-child(3) {
        width: auto;
      }

      thead th,
      tbody td {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .status-cell-stack,
      .action-cell-layout {
        grid-template-columns: minmax(0, 1fr);
      }

      .history-rail {
        min-width: 0;
        padding-top: 0;
      }

      .history-rail__menu {
        right: 0;
        top: calc(100% + 8px);
      }
    }

    @media (max-width: 820px) {
      .table-wrap {
        overflow: visible;
      }

      table {
        min-width: 0;
      }

      thead {
        display: none;
      }

      tbody {
        display: grid;
        gap: 10px;
      }

      tbody tr {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        display: grid;
        gap: 8px;
        grid-template-columns: minmax(0, 1fr);
        padding: 10px;
      }

      tbody td {
        align-items: start;
        display: grid;
        gap: 4px;
        grid-template-columns: minmax(112px, 40%) minmax(0, 1fr);
        padding: 0;
      }

      tbody td::before {
        color: var(--ink-muted);
        content: attr(data-label);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      tbody td[data-label="Enrollment action"] {
        gap: 8px;
        grid-template-columns: minmax(0, 1fr);
      }

      tbody td[data-label="Enrollment action"]::before {
        content: "Enrollment action";
      }

      .action-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .action-comment-row {
        align-items: start;
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .action-comment-row .comment-input {
        inline-size: auto;
        grid-column: 1;
        min-width: 0;
        padding-inline-end: 8px;
        width: 100%;
      }

      .action-comment-row .history-rail {
        grid-column: 2;
        justify-self: end;
      }

      .student-ident strong {
        font-size: 1.08rem;
        line-height: 1.25;
      }

      .student-ident small {
        font-size: 0.92rem;
        line-height: 1.35;
      }

      .action-grid [data-apply] {
        order: 5;
        width: 100%;
      }

      .action-grid .action-comment {
        order: 4;
      }
    }

    @media (max-width: 720px) {
      .app-brand-logo-wrap {
        height: 42px;
        width: 42px;
      }

      .text-zoom-controls .global-text-label,
      .text-zoom-controls .zoom-label {
        display: none;
      }
    }

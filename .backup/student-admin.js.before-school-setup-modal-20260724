        const normalized = normalizeUiSettings(settings);
        const normalizedSisConfig = normalizeSisConfig(sisConfig);
        try {
          return await api(ADMIN_UI_SETTINGS_PATH, {
            method: "PUT",
            body: {
              uiSettings: normalized,
              sisConfig: normalizedSisConfig,
            },

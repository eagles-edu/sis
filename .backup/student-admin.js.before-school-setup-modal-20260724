        state.sisConfigMeta = metaOverride && typeof metaOverride === "object" ? metaOverride : null;
        void window.SIS_PORTAL_PREFERENCES?.save("sis.admin.sisConfig", { ...normalized, meta: state.sisConfigMeta });
        return normalized;

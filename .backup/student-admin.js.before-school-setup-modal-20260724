          preferredStudentId = "",
          preferredAssignmentId = "",
        } = options;
        renderParentTrackingLevelTiles();
        ensureParentTrackingFormDefaults({ forceSummaryFromMemory: false });
        refreshParentTrackingStudentOptions({

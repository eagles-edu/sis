        fields.forEach((field) => {
          if (!fieldsByTab.has(field.tabId)) fieldsByTab.set(field.tabId, []);
          fieldsByTab.get(field.tabId).push(field);
        });

        const tabs = PROFILE_FORM_TABS.filter(
          (tab) => (fieldsByTab.get(tab.id) || []).length > 0,

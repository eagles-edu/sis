        const lines = parentTrackingRecommendationTextareas()
          .map((entry) => normalizeText(entry?.value).replace(/\s+/g, " ").trim())
          .filter(Boolean)
          .slice(0, limit);
        if (!lines.length) return "";
        return `Corrective actions: ${lines.join(" | ")}`;

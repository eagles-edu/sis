generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id                String              @id @default(cuid())
  externalKey       String              @unique
  studentNumber     Int                 @unique
  eaglesId          String              @unique
  email             String?
  submissions       ExerciseSubmission[]
  incomingExerciseResults IncomingExerciseResult[]
  profile           StudentProfile?
  intakeSubmissions StudentIntakeSubmission[]
  attendanceRecords StudentAttendance[]
  gradeRecords      StudentGradeRecord[]
  parentReports     ParentClassReport[]
  pointsAdjustments StudentPointsAdjustment[]
  newsReports       StudentNewsReport[]
  enrollmentPeriods StudentEnrollmentPeriod[]
  parentPortalLinks ParentPortalStudentLink[]
  studentPortalAccount StudentPortalAccount?
  parentProfileSubmissions ParentProfileSubmissionQueue[]
  parentProfileFieldLocks ParentProfileFieldLock[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([email])
}

model Exercise {
  id          String               @id @default(cuid())
  slug        String               @unique
  title       String
  submissions ExerciseSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ExerciseSubmission {
  id                 String   @id @default(cuid())
  studentRefId       String
  exerciseRefId      String
  student            Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exercise           Exercise @relation(fields: [exerciseRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedEaglesId  String
  submittedEmail     String?
  sourceSystem       String?
  sourceAttemptId    String?
  sourceOriginLabel  String?
  sourceOriginHost   String?
  completedAt        DateTime
  totalQuestions     Int
  correctCount       Int
  pendingCount       Int
  incorrectCount     Int
  scorePercent       Float
  recipientsJson     Json?
  createdAt          DateTime @default(now())

  @@unique([sourceSystem, sourceAttemptId])
  @@index([studentRefId, completedAt])
  @@index([exerciseRefId, completedAt])
  @@index([submittedEaglesId, completedAt])
}

model IncomingExerciseResult {
  id                 String   @id @default(cuid())
  status             String
  submittedEaglesId  String
  submittedEmail     String?
  sourceSystem       String?
  sourceAttemptId    String?
  pageTitle          String
  sourceOriginLabel  String?
  sourceOriginHost   String?
  completedAt        DateTime
  totalQuestions     Int
  correctCount       Int
  pendingCount       Int
  incorrectCount     Int
  scorePercent       Float
  recipientsJson     Json?
  payloadJson        Json?
  notes              String?
  reviewedByUsername String?
  matchedStudentRefId String?
  matchedStudent     Student? @relation(fields: [matchedStudentRefId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sourceSystem, sourceAttemptId])
  @@index([status, createdAt])
  @@index([submittedEaglesId, createdAt])
  @@index([submittedEmail, createdAt])
  @@index([matchedStudentRefId, createdAt])
}

model AssignmentTemplate {
  id             String   @id
  assignmentTitle String
  exerciseTitle  String?
  assignedAt     String?
  dueAt          String?
  level          String?
  eaglesId       String?
  message        String?
  itemsJson      Json?
  assignmentBundleJson Json?
  completed      Boolean  @default(false)
  completedAt    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([level, dueAt])
  @@index([assignedAt, dueAt])
  @@index([updatedAt])
}

model SisConfigMirror {
  id         String   @id
  payloadJson Json
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum IntakeControlType {
  text
  textarea
  number
  email
  select
  checkbox
  radio
  date
  unknown
  meta
}

enum SchoolQuarter {
  q1
  q2
  q3
  q4
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum AdminUserRole {
  admin
  teacher
}

enum StudentEnrollmentStatus {
  active
  unenrolled
}

enum StudentUnenrollmentReason {
  moved_residence
  changed_esl_center
  financial
  with_prejudice
  distance_traffic
  stopped_learning_esl
  changed_languages
  pre_high_school_exam_tutoring
  pre_college_exam_tutoring
  unknown
}

model IntakeFieldDefinition {
  id           String            @id @default(cuid())
  formId       String
  fieldKey     Int
  dataName     String
  label        String?
  controlType  IntakeControlType
  required     Boolean           @default(false)
  sourceOrder  Int
  optionsJson  Json?
  metadataJson Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([formId, fieldKey])
  @@index([formId, dataName])
}

model StudentProfile {
  id                         String   @id @default(cuid())
  studentRefId               String   @unique
  student                    Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceFormId               String
  sourceUrl                  String?
  fullName                   String?
  englishName                String?
  memberSince                String?
  exercisePoints             Int?
  parentsId                  String?
  photoUrl                   String?
  genderSelections           String[]
  studentPhone               String?
  studentEmail               String?
  hobbies                    String?
  dobText                    String?
  birthOrder                 Int?
  siblingBrothers            Int?
  siblingSisters             Int?
  ethnicity                  String?
  languagesAtHome            String[]
  otherLanguage              String?
  schoolName                 String?
  currentGrade               String?
  currentSchoolGrade         String?
  motherName                 String?
  motherEmail                String?
  motherPhone                String?
  motherEmergencyContact     String?
  motherMessenger            String?
  fatherName                 String?
  fatherEmail                String?
  fatherPhone                String?
  fatherEmergencyContact     String?
  fatherMessenger            String?
  streetAddress              String?
  newAddress                 String?
  wardDistrict               String?
  city                       String?
  postCode                   String?
  hasGlasses                 String?
  hadEyeExam                 String?
  lastEyeExamDateText        String?
  prescriptionMedicine       String?
  prescriptionDetails        String?
  learningDisorders          String[]
  learningDisorderDetails    String?
  drugAllergies              String?
  foodEnvironmentalAllergies String?
  vaccinesChildhoodUpToDate  String?
  hadCovidPositive           String?
  covidNegativeDateText      String?
  covidShotAlready           String?
  covidVaccinesUpToDate      String?
  covidShotHistory           String[]
  mostRecentCovidShotDate    String?
  feverMedicineAllowed       String[]
  whiteOilAllowed            String?
  signatureFullName          String?
  signatureEmail             String?
  extraComments              String?
  requiredValidationOk       Boolean?
  rawFormPayload             Json?
  normalizedFormPayload      Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([sourceFormId, createdAt])
}

model StudentIntakeSubmission {
  id                   String   @id @default(cuid())
  studentRefId         String
  student              Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceFormId         String
  sourceUrl            String?
  submittedAt          DateTime
  fieldsJson           Json
  missingRequiredJson  Json?
  requiredValidationOk Boolean?
  createdAt            DateTime @default(now())

  @@index([studentRefId, submittedAt])
  @@index([sourceFormId, submittedAt])
}

model StudentAttendance {
  id             String           @id @default(cuid())
  studentRefId   String
  student        Student          @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollmentPeriodId String?
  enrollmentPeriod   StudentEnrollmentPeriod? @relation("EnrollmentPeriodAttendanceRecords", fields: [enrollmentPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  className      String
  level          String?
  schoolYear     String
  quarter        SchoolQuarter
  attendanceDate DateTime
  status         AttendanceStatus @default(present)
  comments       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([studentRefId, className, attendanceDate])
  @@index([studentRefId, attendanceDate])
  @@index([enrollmentPeriodId])
  @@index([level, schoolYear, quarter, attendanceDate])
}

model StudentGradeRecord {
  id                String        @id @default(cuid())
  studentRefId      String
  student           Student       @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollmentPeriodId String?
  enrollmentPeriod   StudentEnrollmentPeriod? @relation("EnrollmentPeriodGradeRecords", fields: [enrollmentPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  className         String
  level             String?
  schoolYear        String
  quarter           SchoolQuarter
  assignmentName    String
  dueAt             DateTime?
  submittedAt       DateTime?
  score             Float?
  maxScore          Float?
  homeworkCompleted Boolean?
  homeworkOnTime    Boolean?
  behaviorScore     Int?
  participationScore Int?
  inClassScore      Int?
  comments          String?
  sourceSystem      String?
  sourceAttemptId   String?
  sourceOriginLabel String?
  sourceOriginHost  String?
  assignmentBundleJson Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([sourceSystem, sourceAttemptId])
  @@index([studentRefId, schoolYear, quarter])
  @@index([enrollmentPeriodId])
  @@index([className, schoolYear, quarter])
  @@index([dueAt])
}

model ParentClassReport {
  id                     String        @id @default(cuid())
  studentRefId           String
  student                Student       @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollmentPeriodId     String?
  enrollmentPeriod       StudentEnrollmentPeriod? @relation("EnrollmentPeriodParentReports", fields: [enrollmentPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  className              String
  level                  String?
  schoolYear             String
  quarter                SchoolQuarter
  homeworkCompletionRate Float?
  homeworkOnTimeRate     Float?
  behaviorScore          Float?
  participationScore     Float?
  inClassScore           Float?
  participationPointsAward Int?
  workflowState          String        @default("draft_pr")
  submittedAt            DateTime?
  submittedByUsername    String?
  adminReviewStartedAt   DateTime?
  adminReviewStartedByUsername String?
  rcDraftedAt            DateTime?
  rcDraftedByUsername    String?
  approvedAt             DateTime?
  approvedByUsername     String?
  publishedAt            DateTime?
  notificationQueuedAt   DateTime?
  notificationSentAt     DateTime?
  finalArtifactVersion   Int           @default(0)
  finalArtifactPayload   Json?
  finalArtifactFrozenAt  DateTime?
  comments               String?
  rubricPayload          Json?
  metaPayload            Json?
  generatedAt            DateTime      @default(now())
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([studentRefId, className, schoolYear, quarter, enrollmentPeriodId])
  @@index([enrollmentPeriodId])
  @@index([level, schoolYear, quarter])
  @@index([workflowState, schoolYear, quarter, generatedAt])
  @@index([approvedAt])
}

model ParentClassReportEvent {
  id              String   @id @default(cuid())
  reportId        String
  artifactVersion Int?
  eventType       String
  eventAt         DateTime @default(now())
  actorType       String?
  actorId         String?
  recipientEmail  String?
  channel         String?
  userAgent       String?
  ipHash          String?
  metadataJson    Json?

  @@index([reportId, eventAt])
  @@index([eventType, eventAt])
  @@index([recipientEmail, eventAt])
}

model StudentPointsAdjustment {
  id               String   @id @default(cuid())
  studentRefId     String
  student          Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pointsDelta      Int
  reason           String?
  adjustedByUsername String?
  appliedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentRefId, appliedAt])
}

model StudentNewsReport {
  id            String   @id @default(cuid())
  studentRefId  String
  student       Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollmentPeriodId String?
  enrollmentPeriod   StudentEnrollmentPeriod? @relation("EnrollmentPeriodNewsReports", fields: [enrollmentPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportDate    DateTime
  sourceLink    String
  articleTitle  String
  byline        String?
  articleDateline String?
  leadSynopsis  String
  actionActor   String
  actionAffected String
  actionWhere   String
  actionWhat    String
  actionWhy     String
  biasAssessment String?
  vocabularyJson Json?
  submissionState String @default("submitted")
  draftCheckedAt DateTime?
  mmrPassedAt DateTime?
  dateSatisfiedAt DateTime?
  reportDateLockedAt DateTime?
  firstSubmittedAt DateTime?
  lastSubmittedAt DateTime?
  editableUntil DateTime?
  submittedAt   DateTime @default(now())
  reviewStatus  String   @default("submitted")
  reviewNote    String?
  validationIssuesJson Json?
  reviewedAt    DateTime?
  reviewedByUsername String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentRefId, reportDate])
  @@index([enrollmentPeriodId])
  @@index([reportDate, submittedAt])
  @@index([reviewStatus, reportDate, submittedAt])
  @@index([submissionState, reportDate, submittedAt])
  @@index([reviewedAt])
}

model StudentEnrollmentPeriod {
  id                    String                    @id @default(cuid())
  studentRefId          String
  student               Student                   @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schoolYear            String
  level                 String?
  status                StudentEnrollmentStatus
  startedAt             DateTime
  endedAt               DateTime?
  unenrollmentReason    StudentUnenrollmentReason?
  comment               String?
  promotedFromPeriodId  String?
  promotedFromPeriod    StudentEnrollmentPeriod?  @relation("EnrollmentPromotionChain", fields: [promotedFromPeriodId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promotedToPeriods     StudentEnrollmentPeriod[] @relation("EnrollmentPromotionChain")
  attendanceRecords     StudentAttendance[]       @relation("EnrollmentPeriodAttendanceRecords")
  gradeRecords          StudentGradeRecord[]      @relation("EnrollmentPeriodGradeRecords")
  parentReports         ParentClassReport[]       @relation("EnrollmentPeriodParentReports")
  newsReports           StudentNewsReport[]       @relation("EnrollmentPeriodNewsReports")
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([studentRefId, schoolYear])
  @@index([status, schoolYear, level])
  @@index([promotedFromPeriodId])
}

model AdminUser {
  id           String        @id @default(cuid())
  username     String        @unique
  role         AdminUserRole @default(teacher)
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
}

model AdminNotificationQueue {
  id               String   @id @default(cuid())
  queueType        String
  status           String
  deliveryMode     String
  recipients       String[]
  assignmentTitle  String
  exerciseTitle    String?
  level            String?
  dueAt            String?
  message          String?
  senderName       String?
  queuedByUsername String?
  reviewedByUsername String?
  studentReviewedAt DateTime?
  studentReviewedByUsername String?
  parentReviewedAt DateTime?
  parentReviewedByUsername String?
  scheduledFor     DateTime?
  sentAt           DateTime?
  attempts         Int      @default(0)
  lastError        String?
  payloadJson      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([queueType, status, createdAt])
  @@index([status, scheduledFor, createdAt])
}

model AsyncSideEffectJob {
  id           String   @id
  jobType      String
  status       String   @default("queued")
  dedupeKey    String?
  payloadJson  Json?
  resultJson   Json?
  lastError    String?
  attempts     Int      @default(0)
  availableAt  DateTime?
  lockedAt     DateTime?
  lockedBy     String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jobType, dedupeKey])
  @@index([status, availableAt, createdAt])
  @@index([jobType, status, availableAt, createdAt])
  @@index([lockedAt])
}

model ParentPortalAccount {
  id               String   @id @default(cuid())
  parentsId        String   @unique
  passwordHash     String
  status           String   @default("active")
  lastLoginAt      DateTime?
  links            ParentPortalStudentLink[]
  profileSubmissions ParentProfileSubmissionQueue[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model ParentPortalStudentLink {
  id              String   @id @default(cuid())
  parentAccountId String
  studentRefId    String
  parentAccount   ParentPortalAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student         Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime @default(now())

  @@unique([parentAccountId, studentRefId])
  @@index([studentRefId])
}

model ParentProfileSubmissionQueue {
  id                   String   @id @default(cuid())
  parentAccountId      String
  studentRefId         String
  status               String
  draftPayloadJson     Json?
  adminEditedPayloadJson Json?
  diffPayloadJson      Json?
  failurePoint         String?
  rejectionReason      String?
  comment              String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedByUsername   String?
  parentAccount        ParentPortalAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student              Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, submittedAt, createdAt])
  @@index([parentAccountId, status, createdAt])
  @@index([studentRefId, status, createdAt])
}

model ParentProfileFieldLock {
  id               String   @id @default(cuid())
  studentRefId     String
  fieldKey         String
  locked           Boolean  @default(true)
  reason           String?
  lockedByUsername String?
  student          Student  @relation(fields: [studentRefId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([studentRefId, fieldKey])
  @@index([studentRefId, locked])
}

model StudentPortalAccount {
  id               String   @id @default(cuid())
  eaglesId         String   @unique
  passwordHash     String
  status           String   @default("active")
  studentRefId     String?  @unique
  student          Student? @relation(fields: [studentRefId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([studentRefId])
}
